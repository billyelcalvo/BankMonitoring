# Copy to .env to override the docker-compose defaults.
# Required in production: DATABASE_URL and JWT_SECRET (no defaults in the app).

# --- application ---
# HTTP_ADDR=:8080            # or PORT=8080 (Render/Fly set PORT for you)
# DATABASE_URL=postgres://user:pass@host:5432/db?sslmode=require
JWT_SECRET=                  # openssl rand -base64 32
# JWT_ISSUER=bankmonitoring
# JWT_AUDIENCE=bankmonitoring-api
LOG_LEVEL=info               # debug | info | warn | error
DB_MAX_CONNS=20
REQUEST_TIMEOUT=10s
SHUTDOWN_TIMEOUT=10s
RUN_MIGRATIONS=true
SEED_DEMO_DATA=false
DEMO_PASSWORD=               # required when SEED_DEMO_DATA=true (min. 8 chars)

# --- docker compose only ---
POSTGRES_DB=bank
POSTGRES_USER=bank
POSTGRES_PASSWORD=bank
POSTGRES_PORT=5433
API_PORT=8080
